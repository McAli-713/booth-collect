# 复制为 .env 后按注释修改（.env 不要提交到 Git）
# cp .env.example .env

# ---- 必改：数据库密码 ----
POSTGRES_PASSWORD=请改成强密码

# ---- 必改：后台管理员（用户名默认 CR001，密码必须 ≥8 位否则容器启动即退出）----
ADMIN_USERNAME=CR001
ADMIN_PASSWORD=请改成至少8位的强密码

# ---- 对外端口 ----
# NAS 上 3000 常被其他服务占用，冲突时改成 8080 / 5100 等
HOST_PORT=3000

# ---- 可选：外网访问所需（Cloudflare Tunnel）----
# 留空则 tunnel 服务不启用；填了才会随 profile 启动
# 获取方式见 DEPLOY-NAS.md「外网访问」章节
TUNNEL_TOKEN=

# ---- 可选：邮件通知（两项都填才生效，留空则跳过不发信）----
RESEND_API_KEY=
NOTIFICATION_EMAIL=
